{
  "name": "sgk-app",
  "description": "Ứng dụng thư viện và công cụ làm việc dành cho giáo viên tiểu học",
  "private": true,
  "version": "1.0.3",
  "author": "Nguyễn Tuấn",
  "copyright": "© 2026 Nguyễn Tuấn. All rights reserved.",
  "license": "UNLICENSED",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "desktop": "npm run build && electron .",
    "dist:win": "npm run build && electron-builder --win nsis",
    "dist:portable": "npm run build && electron-builder --win portable",
    "dist:local": "node scripts/build-desktop-folder.mjs",
    "lint": "oxlint",
    "test": "node --no-warnings --loader ./test-loader.mjs --test src/**/*.test.js src/**/*.test.jsx src/**/*.spec.js src/**/*.spec.jsx tests/*.test.js tests/*.spec.js server/**/*.test.js server/**/*.spec.js",
    "test:e2e": "node --test --test-concurrency=1 tests/e2e/**/*.spec.js",
    "preview": "vite preview",
    "start": "node --no-warnings server.js",
    "start:bg": "powershell -NoProfile -Command \"Start-Process -FilePath 'node' -ArgumentList '--no-warnings','server.js' -WorkingDirectory $PWD -WindowStyle Hidden\"",
    "dev:frontend": "vite",
    "dev:backend": "node --no-warnings server.js",
    "dev:all": "npx --yes concurrently -k -n API,WEB --raw \"npm:dev:backend\" \"npm:dev:frontend\"",
    "dev:all:legacy": "start \"SGK API\" cmd /c \"node --no-warnings server.js\" && start \"SGK Vite\" cmd /c \"vite\""
  },
  "dependencies": {
    "cors": "^2.8.5",
    "docx": "^9.7.1",
    "dompurify": "^3.4.16",
    "electron-updater": "^6.8.11",
    "express": "^4.19.2",
    "jszip": "^3.10.2",
    "lucide-react": "^0.428.0",
    "mammoth": "^1.12.3",
    "multer": "^2.2.0",
    "pdfjs-dist": "^3.4.120",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "sanitize-html": "^2.18.0",
    "xlsx": "file:vendor/xlsx-0.20.3.tgz"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.4",
    "concurrently": "^8.2.2",
    "electron": "^39.8.10",
    "electron-builder": "^26.18.0",
    "oxlint": "^1.75.0",
    "playwright-core": "^1.62.1",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0"
  },
  "main": "electron/main.cjs",
  "build": {
    "appId": "vn.nguyentuan.sgkteacherworkspace",
    "productName": "SGK Teacher Workspace",
    "directories": {
      "output": "release/windows"
    },
    "files": [
      "electron/**/*",
      "server.js",
      "server/**/*",
      "src/services/docxFaithful.js",
      "dist/**/*",
      "version.json",
      "public/icons/icon-512.png",
      "package.json",
      "!books/**",
      "!lesson-images/**",
      "!docs/**",
      "!tests/**",
      "!KHBD-test/**",
      "!*.log",
      "!server.pid",
      "!node_modules/canvas",
      "!node_modules/canvas/**/*"
    ],
    "asar": true,
    "npmRebuild": false,
    "win": {
      "icon": "public/icons/icon-512.png",
      "signAndEditExecutable": true,
      "requestedExecutionLevel": "asInvoker",
      "legalTrademarks": "SGK Teacher Workspace",
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        },
        {
          "target": "portable",
          "arch": [
            "x64"
          ]
        }
      ]
    },
    "nsis": {
      "oneClick": false,
      "perMachine": false,
      "allowElevation": false,
      "allowToChangeInstallationDirectory": true,
      "packElevateHelper": false,
      "createDesktopShortcut": "always",
      "createStartMenuShortcut": true,
      "shortcutName": "SGK Teacher Workspace",
      "uninstallDisplayName": "SGK Teacher Workspace ${version}",
      "deleteAppDataOnUninstall": false,
      "runAfterFinish": true,
      "artifactName": "SGK-Teacher-Workspace-Setup-${version}.${ext}"
    },
    "portable": {
      "artifactName": "${productName} Portable ${version}.${ext}",
      "requestExecutionLevel": "user"
    },
    "publish": [
      {
        "provider": "github",
        "owner": "lllt2klll-droid",
        "repo": "book-update"
      }
    ]
  },
  "allowScripts": {
    "electron@39.8.10": true
  }
}
